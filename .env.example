# Maestro - paramètres personnels
# Copiez ce fichier en .env et modifiez les valeurs. Une ligne commentée (#) = valeur par défaut.
# Booléens : true / false. Tous les paramètres de maestro/config.py peuvent être mis ici.

# --- Général ---------------------------------------------------------------
CLASSIFIER=rules    
PLAYER=media          # rules | ml | yolo  (classifieur de python main.py)
MUSIC_DIR=music               # dossier des morceaux (relatif au projet ou chemin complet)

# --- Spotify (si PLAYER=spotify) : https://developer.spotify.com/dashboard -----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_PLAYLIST=             # nom d'une de VOS playlists (vide = la première)
SPOTIFY_DEVICE=               # vide = l'appareil Spotify actif

# --- Caméra ----------------------------------------------------------------
CAMERA_INDEX=0                # 1, 2... pour une autre webcam
FRAME_WIDTH=960
FRAME_HEIGHT=540
MIRROR=true

# --- Mains -----------------------------------------------------------------
LEFT_HANDED=true              # true : main droite = volume, main gauche = morceaux
SWAP_HANDEDNESS=false         # true si MediaPipe inverse gauche et droite

# --- Voix « Maestro » ------------------------------------------------------
VOICE_ENABLED=true
AUTO_SLEEP_S=60               # veille sans main visible (0 = jamais)
STOP_PAUSES_MUSIC=true
DUCK_ENABLED=true             # baisse la musique quand vous dites « Maestro »
DUCK_LEVEL=0.25

# --- Détection des gestes --------------------------------------------------
STABLE_FRAMES=8               # plus grand = moins de fausses activations, mais plus lent
MIN_CONFIDENCE=0.6            # classifieur ML
YOLO_CONF=0.35                # approche B
YOLO_EVERY=1                  # 2 = YOLO une image sur deux (plus fluide sur un PC lent)

# --- Affichage -------------------------------------------------------------
DISPLAY_HEIGHT=720
START_FULLSCREEN=false
SHOW_VISUALIZER=false
